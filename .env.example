# Copy this file to .env and fill in real values. .env is git-ignored; this example file is safe to commit.

# Local LLM (Phase 0+) - free, runs on your laptop via Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Used by the Week 1 clients_cli exercise
REPORT_CURRENCY=USD

# Cloud LLM keys (Phase 1+). Leave blank until you need them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Phase 2: Supabase / Postgres with pgvector
DATABASE_URL=
